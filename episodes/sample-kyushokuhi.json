      "layout": "anchor",
      "lines": [
        {
          "id": "s2l1",
          "speaker": "anchor",
          "text": "来年度から、給食費が月500円上がります。",
          "telop": "来年度から、\n給食費が月500円\n上がります。",
          "emphasis": ["月500円"],
