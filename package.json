{
  "name": "machi-ai-hoso",
  "version": "0.1.0",
  "private": true,
  "description": "まちのAI放送局 — turns municipal council decisions into short animated news videos",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tts": "python scripts/tts.py",
    "sfx": "python scripts/synth_audio.py",
    "fetch": "tsx scripts/fetch-sources.ts",
    "generate": "tsx scripts/generate.ts",
    "render": "tsx scripts/render.ts",
    "app": "tsx server/index.ts",
    "studio": "remotion studio",
    "still": "remotion still Episode out/still.png --frame=60",
    "typecheck": "tsc",
    "demo:record": "node demo/record.mjs site make result audiences towns",
    "demo:narrate": "python demo/narrate.py",
    "demo:render": "remotion render src/index.ts Demo out/demo.mp4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
